      <aliases enabled='yes' />
      <column caption='Category Highlight' datatype='string' name='[Calculation_3639148899954689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Product_Category] = &quot;Software&quot; THEN &quot;Top Performer&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Region Highlight' datatype='string' name='[Calculation_3639148951777282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Region] = &quot;West&quot; THEN &quot;Top Performer&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Discount Range' datatype='string' name='[Calculation_3639149247250435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ROUND([Discount_Percentage], 2) &lt; 0.10 THEN &quot;Under 10%&quot;&#10;ELSEIF ROUND([Discount_Percentage], 2) &lt; 0.20 THEN &quot;10% to 19%&quot;&#10;ELSEIF ROUND([Discount_Percentage], 2) &lt; 0.30 THEN &quot;20% to 29%&quot;&#10;ELSE &quot;30% or More&quot;&#10;END' />
      </column>
      <column caption='Profit Margin (%)' datatype='real' name='[Calculation_3639149310763014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Revenue])' />
      </column>
      <column caption='Year Highlight' datatype='string' name='[Calculation_3639151149113351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([Transaction_Date]) = 2026 THEN &quot;2026&quot;&#10;ELSE &quot;2023–2025&quot;&#10;END' />
      </column>
      <column caption='Revenue Period Highlight' datatype='string' name='[Calculation_3639151343243272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([Transaction_Date]) IN (2023, 2024) THEN &quot;2023–2024 Revenue&quot;&#10;ELSEIF YEAR([Transaction_Date]) = 2025 THEN &quot;2025 Revenue&quot;&#10;ELSEIF YEAR([Transaction_Date]) = 2026 THEN &quot;2026 Revenue&quot;&#10;END' />
      </column>
      <column caption='Profit Margin Period Highlight' datatype='string' name='[Calculation_3639151345475594]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF YEAR([Transaction_Date]) = 2023 THEN &quot;2023 Profit Margin&quot;&#10;ELSEIF YEAR([Transaction_Date]) IN (2025, 2026) THEN &quot;2025–2026 Profit Margin&quot;&#10;ELSEIF YEAR([Transaction_Date]) = 2024 THEN &quot;2024 Profit Margin&quot;&#10;END' />
      </column>
      <column caption='Profit Change Q2 vs. Q1' datatype='integer' name='[Calculation_3639151867379724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Product_Name] :&#10;    SUM(&#10;        IF YEAR([Transaction_Date]) = 2025&#10;        AND DATEPART(&apos;quarter&apos;, [Transaction_Date]) = 2&#10;        AND [Region] = &quot;South&quot;&#10;        AND [Product_Category] = &quot;Office Supplies&quot;&#10;        AND [Order_Status] = &quot;Completed&quot;&#10;        THEN [Profit]&#10;        END&#10;    )&#10;}&#10;-&#10;{ FIXED [Product_Name] :&#10;    SUM(&#10;        IF YEAR([Transaction_Date]) = 2025&#10;        AND DATEPART(&apos;quarter&apos;, [Transaction_Date]) = 1&#10;        AND [Region] = &quot;South&quot;&#10;        AND [Product_Category] = &quot;Office Supplies&quot;&#10;        AND [Order_Status] = &quot;Completed&quot;&#10;        THEN [Profit]&#10;        END&#10;    )&#10;}' />
      </column>
