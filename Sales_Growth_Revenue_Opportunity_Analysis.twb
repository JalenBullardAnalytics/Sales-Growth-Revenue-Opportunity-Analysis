      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' default-format='p0.0%' name='[Calculation_3639148516339712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Revenue])' />
      </column>
      <column caption='Category Highlight' datatype='string' name='[Calculation_3639148899954689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Product_Category] = &quot;Software&quot; THEN &quot;Top Performer&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Region Highlight' datatype='string' name='[Calculation_3639148951777282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Region] = &quot;West&quot; THEN &quot;Top Performer&quot;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Discount Range' datatype='string' name='[Calculation_3639149247250435]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount_Percentage] &lt; 0.10 THEN &quot;Under 10%&quot;&#10;ELSEIF [Discount_Percentage] &lt; 0.20 THEN &quot;10% to 19%&quot;&#10;ELSEIF [Discount_Percentage] &lt; 0.30 THEN &quot;20% to 29%&quot;&#10;ELSE &quot;30% or More&quot;&#10;END' />
      </column>
      <column caption='Profit Margin (%)' datatype='real' name='[Calculation_3639149251227652]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Revenue])' />
      </column>
      <column caption='Q1 Revenue' datatype='real' name='[Calculation_3639153025581069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF DATEPART(&apos;quarter&apos;,[Transaction_Date]) = 1&#10;    THEN [Revenue]&#10;    END&#10;)' />
      </column>
      <column caption='Q2 Revenue' datatype='real' name='[Calculation_3639153025732622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF DATEPART(&apos;quarter&apos;,[Transaction_Date]) = 2&#10;    THEN [Revenue]&#10;    END&#10;)' />
      </column>
      <column caption='Revenue Change Q2 vs. Q1' datatype='real' name='[Calculation_3639153025847311]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_3639153025732622] - [Calculation_3639153025581069]) / [Calculation_3639153025581069]' />
      </column>
      <column caption='Revenue Trend Arrow' datatype='string' name='[Calculation_3639153026052112]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3639153025847311] &gt; 0 THEN&#10;    &quot;▲&quot;&#10;ELSEIF [Calculation_3639153025847311] &lt; 0 THEN&#10;    &quot;▼&quot;&#10;ELSE&#10;    &quot;—&quot;&#10;END' />
      </column>
      <column caption='Revenue Trend Color' datatype='string' name='[Calculation_3639153029914641]' role='measure' type='nominal'>
